{
  "name": "flowbite-vue",
  "version": "0.4.0",
  "description": "Vue 3 UI component library built on top of Tailwind CSS and Flowbite.",
  "keywords": [
    "vue",
    "vue3",
    "flowbite",
    "tailwindcss",
    "nuxt",
    "components",
    "ui-library"
  ],
  "homepage": "https://flowbite-vue.com/",
  "bugs": {
    "url": "https://github.com/themesberg/flowbite-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themesberg/flowbite-vue.git"
  },
  "license": "MIT",
  "author": "themesberg",
  "type": "module",
  "main": "./dist/flowbite-vue.js",
  "module": "./dist/flowbite-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/flowbite-vue.js"
    },
    "./components/*/types": {
      "types": "./dist/components/*/types.d.ts"
    },
    "./index.css": "./dist/index.css",
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "npm run docs:dev",
    "start": "npm run docs:preview",
    "build": "npm run build:package && npm run build:types",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && cp -r ./docs/assets/* ./docs/.vitepress/dist/assets/",
    "docs:preview": "vitepress serve docs ${PORT:+--port $PORT}",
    "generate:nuxt-components": "node scripts/generate-nuxt-components.mjs",
    "prebuild:package": "npm run generate:nuxt-components",
    "build:package": "vite build && vite build --config vite.nuxt.config.ts",
    "prebuild:types": "npm run generate:nuxt-components",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly && tsc-alias -p tsconfig.json",
    "clean": "rm -fr ./dist && rm -fr ./dist_types && rm -fr ./docs/.vitepress/dist && rm -fr ./docs/.vitepress/cache",
    "prelint": "npm run generate:nuxt-components",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npm run lint:fix",
    "pretypecheck": "npm run generate:nuxt-components",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:nuxt": "npm run build:package && vitest run --config vitest.nuxt.config.ts",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "npm run build:package && npm run check:package",
    "check:pack": "node scripts/check-pack.mjs",
    "test:pack": "npm run build:package && npm run check:pack",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@nuxt/kit": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "floating-vue": "^5.4.0",
    "focus-trap": "^7.8.0",
    "lodash-es": "^4.18.1",
    "nanoid": "^6.0.2",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nuxt/kit": "4.6.4",
    "@nuxt/test-utils": "4.3.4",
    "@stylistic/eslint-plugin": "5.10.0",
    "@tailwindcss/postcss": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.12.0",
    "eslint-plugin-vue-scoped-css": "3.1.3",
    "flowbite": "4.0.2",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "neostandard": "0.14.1",
    "nuxt": "4.6.4",
    "postcss": "8.5.32",
    "postcss-prefix-selector": "2.2.1",
    "tailwindcss": "4.3.4",
    "tsc-alias": "1.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitepress": "1.6.4",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "floating-vue": {
      "@nuxt/kit": "$@nuxt/kit"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.x"
  }
}
