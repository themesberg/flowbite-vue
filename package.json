{
  "name": "flowbite-vue",
  "version": "0.4.0",
  "description": "Vue 3 UI component library built on top of Tailwind CSS and Flowbite.",
  "keywords": [
    "vue",
    "vue3",
    "flowbite",
    "tailwindcss",
    "nuxt",
    "components",
    "ui-library"
  ],
  "homepage": "https://flowbite-vue.com/",
  "bugs": {
    "url": "https://github.com/themesberg/flowbite-vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themesberg/flowbite-vue.git"
  },
  "license": "MIT",
  "author": "themesberg",
  "type": "module",
  "main": "./dist/flowbite-vue.umd.cjs",
  "module": "./dist/flowbite-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/flowbite-vue.js",
      "require": "./dist/flowbite-vue.umd.cjs"
    },
    "./components/*/types": {
      "types": "./dist/components/*/types.d.ts"
    },
    "./index.css": "./dist/index.css",
    "./nuxt": {
      "types": "./dist/nuxt/module.d.ts",
      "import": "./dist/nuxt.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "npm run docs:dev",
    "start": "npm run docs:preview",
    "build": "npm run build:package && npm run build:types",
    "prepublishOnly": "npm run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && cp -r ./docs/assets/* ./docs/.vitepress/dist/assets/",
    "docs:preview": "vitepress serve docs ${PORT:+--port $PORT}",
    "generate:nuxt-components": "node scripts/generate-nuxt-components.mjs",
    "prebuild:package": "npm run generate:nuxt-components",
    "build:package": "vite build && vite build --config vite.nuxt.config.ts",
    "prebuild:types": "npm run generate:nuxt-components",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly && tsc-alias -p tsconfig.json",
    "clean": "rm -fr ./dist && rm -fr ./dist_types && rm -fr ./docs/.vitepress/dist && rm -fr ./docs/.vitepress/cache",
    "prelint": "npm run generate:nuxt-components",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "npm run lint:fix",
    "pretypecheck": "npm run generate:nuxt-components",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:nuxt": "npm run build:package && vitest run --config vitest.nuxt.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@nuxt/kit": "4.5.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/core": "14.3.0",
    "@vueuse/integrations": "14.3.0",
    "floating-vue": "5.2.2",
    "flowbite": "4.0.2",
    "lodash-es": "4.18.1",
    "nanoid": "6.0.0",
    "postcss-prefix-selector": "2.1.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.1.0",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.1.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.10.0",
    "eslint-plugin-vue-scoped-css": "3.1.1",
    "jsdom": "30.0.0",
    "neostandard": "0.13.0",
    "nuxt": "4.5.1",
    "tsc-alias": "1.9.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.8"
  },
  "overrides": {
    "esbuild": ">=0.25.0",
    "floating-vue": {
      "@nuxt/kit": "$@nuxt/kit"
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.x"
  }
}
